# TAO SDK Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# Load before using SDK: source .env

# === Platform Credentials ===
# Lepton (DGX Cloud) — required for LeptonSDK
export LEPTON_WORKSPACE_ID=""
export LEPTON_AUTH_TOKEN=""

# Brev — optional (manual brev login also works)
# export BREV_API_TOKEN=""

# === S3 Storage ===
export ACCESS_KEY=""
export SECRET_KEY=""
export S3_BUCKET_NAME=""
export S3_ENDPOINT_URL=""
# export CLOUD_REGION=""

# === Model Credentials ===
export NGC_KEY=""
